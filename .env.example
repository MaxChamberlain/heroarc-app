# Copy to .env for local development. Never commit .env.
# Production values live in Render (render.yaml + the dashboard env group).
# Ports: the API defaults to 4000 and the web app to 3000 (Render sets PORT per service).

# docker-compose host ports (change if something else already uses them).
POSTGRES_PORT=5432
VALKEY_PORT=6379

DATABASE_URL=postgres://heroarc:heroarc@localhost:5432/heroarc
REDIS_URL=redis://localhost:6379

# Where the web server reaches the API (the browser always uses the web origin's /api proxy).
INTERNAL_API_URL=http://localhost:4000

# Dev seed only (`pnpm db:seed`): the demo account's id and timezone. The app itself uses
# whoever is signed in, and each person's timezone from their profile.
DEV_USER_ID=demo
APP_TIMEZONE=America/Denver

# Oura (sleep, readiness, HRV, steps): HeroArc's own Oura application. Create it at
# https://cloud.ouraring.com/oauth/applications; its page shows the Client ID and Client Secret.
# Its redirect URIs must include <APP_URL>/api/v1/oura/callback
# (locally: http://localhost:3000/api/v1/oura/callback). Scopes: daily, stress.
# Leave empty and "Connect Oura" stays hidden. OURA_CLIENT_ID=fake uses a scripted stand-in (tests).
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=

# Coach (the in-app assistant). Leave the key empty and Coach says it isn't set up.
ANTHROPIC_API_KEY=
# Claude model for Coach. 'fake' runs a scripted stand-in (tests, no API calls).
COACH_MODEL=claude-opus-5-5
# Voice notes are transcribed with OpenAI; without a key the mic is turned off.
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe

# Sign-in (Better Auth). The secret signs sessions: required in production (openssl rand -base64 32).
BETTER_AUTH_SECRET=
# Where people use the app (sign-in links and cookies are for this origin).
APP_URL=http://localhost:3000
# Where outside agents reach the API (https://api.<domain> in production); shown in Settings → Connections.
API_URL=http://localhost:4000
# Email: Resend in production (RESEND_API_KEY + MAIL_FROM on your domain); locally SMTP to Mailpit.
RESEND_API_KEY=
SMTP_URL=smtp://localhost:1025
MAIL_FROM=HeroArc <hello@heroarc.local>
# Google sign-in (optional): an OAuth client from Google Cloud with redirect URI
# <APP_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The local demo account `pnpm db:seed` creates (dev only).
DEMO_EMAIL=demo@heroarc.local
DEMO_USERNAME=demo
DEMO_PASSWORD=heroarc-demo-password
