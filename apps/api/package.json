{
  "name": "@heroarc/api",
  "version": "0.0.0",
  "private": true,
  "description": "HeroArc API (NestJS): web API, Better Auth, MCP + agent REST, chat. Same codebase runs the BullMQ worker.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json && concurrently -k -n tsc,api,worker -c gray,cyan,magenta \"tsc -p tsconfig.build.json -w --preserveWatchOutput\" \"node --watch --env-file-if-exists=../../.env dist/main.js\" \"node --watch --env-file-if-exists=../../.env dist/worker.js\"",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "start:worker": "node --env-file-if-exists=../../.env dist/worker.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.14.0",
    "@better-auth/cimd": "1.7.28",
    "@better-auth/mcp": "1.7.28",
    "@better-auth/oauth-provider": "1.7.28",
    "@heroarc/contracts": "workspace:*",
    "@heroarc/db": "workspace:*",
    "@heroarc/domain": "workspace:*",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@modelcontextprotocol/server": "2.4.0",
    "@nestjs/common": "12.6.2",
    "@nestjs/core": "12.6.2",
    "@nestjs/platform-express": "12.6.2",
    "@orpc/contract": "1.16.6",
    "@orpc/nest": "1.16.6",
    "@orpc/server": "1.16.6",
    "better-auth": "1.7.28",
    "bullmq": "6.7.10",
    "ioredis": "6.1.0",
    "jose": "6.2.18",
    "nodemailer": "10.6.1",
    "openai": "7.65.0",
    "read-excel-file": "9.3.20",
    "reflect-metadata": "0.2.2",
    "resend": "6.40.1",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@heroarc/config": "workspace:*",
    "@modelcontextprotocol/client": "2.4.0",
    "@nestjs/testing": "12.6.2",
    "@swc/core": "1.16.22",
    "@types/express": "^5",
    "@types/node": "^22",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "7.2.1",
    "concurrently": "10.0.7",
    "supertest": "7.3.2",
    "typescript": "6.0.3",
    "unplugin-swc": "2.0.0",
    "vitest": "5.1.2",
    "write-excel-file": "^4.1.1"
  }
}
