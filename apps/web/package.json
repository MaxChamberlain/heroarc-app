{
  "name": "@heroarc/web",
  "version": "0.0.0",
  "private": true,
  "description": "HeroArc web app (TanStack Start). Serves the UI and proxies /api/* to the API over Render's private network.",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "node --env-file-if-exists=../../.env .output/server/index.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@better-auth/oauth-provider": "1.7.28",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@heroarc/contracts": "workspace:*",
    "@heroarc/domain": "workspace:*",
    "@orpc/client": "1.16.6",
    "@orpc/contract": "1.16.6",
    "@orpc/openapi-client": "1.16.6",
    "@orpc/tanstack-query": "1.16.6",
    "@tanstack/react-query": "5.108.4",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.7",
    "better-auth": "1.7.28",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-grid-layout": "2.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@heroarc/config": "workspace:*",
    "@types/node": "^22",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "nitro": "3.0.261103-rc",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.2"
  }
}
