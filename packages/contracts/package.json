{
  "name": "@heroarc/contracts",
  "version": "0.0.0",
  "private": true,
  "description": "Single source of truth for the HeroArc API: zod schemas + oRPC contract (web API) and, later, agent tool specs.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@orpc/contract": "1.16.6",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@heroarc/config": "workspace:*",
    "@types/node": "^22",
    "typescript": "6.0.3",
    "vitest": "5.1.2"
  }
}
