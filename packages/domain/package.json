{
  "name": "@heroarc/domain",
  "version": "0.0.0",
  "private": true,
  "description": "Pure, framework-free HeroArc business logic (calculators, trends, pillar progress). No I/O.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@heroarc/config": "workspace:*",
    "@types/node": "^22",
    "typescript": "6.0.3",
    "vitest": "5.1.2"
  },
  "dependencies": {
    "@heroarc/contracts": "workspace:*"
  }
}
